{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "forkProcessing:enabled"
  ],
  "timezone": "America/Los_Angeles",
  "schedule": [
    "at any time"
  ],
  "automergeSchedule": [
    "* 12-15 * * *"
  ],
  "platformAutomerge": false,
  "dependencyDashboard": true,
  "assignees": [
    "rpeters1430"
  ],
  "assignAutomerge": true,
  "labels": [
    "dependencies",
    "renovate"
  ],
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "description": "Create updates immediately and consolidate updates requiring manual review",
      "matchPackageNames": [
        "*"
      ],
      "minimumReleaseAge": "0 days",
      "schedule": [
        "at any time"
      ],
      "prCreation": "immediate",
      "dependencyDashboardApproval": false,
      "groupName": "Dependency updates requiring review",
      "groupSlug": "dependencies-requiring-review",
      "groupSingleUpdates": true,
      "minimumGroupSize": 1,
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false,
      "separateMultipleMinor": false,
      "automerge": false
    },
    {
      "description": "Group and automerge stable minor and patch updates",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "/^[1-9]\\d*\\./",
      "groupName": "Safe non-major dependency updates",
      "groupSlug": "safe-non-major-dependencies",
      "groupSingleUpdates": true,
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group and automerge dependency pins",
      "matchUpdateTypes": [
        "pin"
      ],
      "matchCurrentVersion": "/^[1-9]\\d*\\./",
      "groupName": "Safe non-major dependency updates",
      "groupSlug": "safe-non-major-dependencies",
      "groupSingleUpdates": true,
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group and automerge GitHub Actions digest updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "Safe non-major dependency updates",
      "groupSlug": "safe-non-major-dependencies",
      "groupSingleUpdates": true,
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "minimumReleaseAge": "0 days",
  "prCreation": "immediate",
  "prHourlyLimit": 0
}
