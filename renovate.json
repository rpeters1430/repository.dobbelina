{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "forkProcessing": "enabled",
  "timezone": "America/Los_Angeles",
  "schedule": [
    "at any time"
  ],
  "automergeSchedule": [
    "* 12-15 * * *"
  ],
  "platformAutomerge": false,
  "dependencyDashboard": true,
  "assignees": [
    "rpeters1430"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "prCreation": "immediate",
  "packageRules": [
    {
      "description": "Group major updates for manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "Major dependency updates",
      "groupSlug": "major-dependencies",
      "automerge": false
    },
    {
      "description": "Group minor updates for manual review",
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "Minor dependency updates",
      "groupSlug": "minor-dependencies",
      "automerge": false
    },
    {
      "description": "Group and automerge patch updates",
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Patch dependency updates",
      "groupSlug": "patch-dependencies",
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Review dependency pinning changes",
      "matchUpdateTypes": [
        "pin"
      ],
      "groupName": "Dependency pin updates",
      "automerge": false
    },
    {
      "description": "Review GitHub Actions digest changes",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "GitHub Actions digest updates",
      "automerge": false
    }
  ]
}
